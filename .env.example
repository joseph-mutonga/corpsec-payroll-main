# =============================================================================
# CorpSec Security Workforce & Statutory Payroll Management System
# Environment Configuration Template (.env.example)
# Configured for MySQL 8.0 Community Server
# Compliant with Kenyan Labor Laws, NSSF Act 2013, SHIF 2024 & KRA PAYE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------------------
PROJECT_NAME="CorpSec Payroll System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# -----------------------------------------------------------------------------
# 2. SECURITY, AUTHENTICATION & JWT TOKENS
# -----------------------------------------------------------------------------
# Secret key used for JWT bearer token signing (change to a unique 64-char string in production)
SECRET_KEY="corpsec-super-secret-jwt-signing-key-production-ready-2026"
ALGORITHM="HS256"
# Access token expiration in minutes (1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [CRITICAL SECURITY REQUIREMENT]
# Startup will HALT with RuntimeError if ADMIN_INITIAL_PASSWORD is empty or unset.
# Used on initial database seeding for 'admin@corpsec.co.ke'.
ADMIN_INITIAL_PASSWORD="Admin@CorpSec2026!"

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL 8.0 Community Server)
# -----------------------------------------------------------------------------
# Active MySQL 8.0 Community Server connection string:
DATABASE_URL="mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/corpsec_payroll?charset=utf8mb4"

# Fallback SQLite Database:
# DATABASE_URL="sqlite:///./corpsec_payroll.db"

# -----------------------------------------------------------------------------
# 4. CORS ORIGINS
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# 5. KENYAN STATUTORY DEFAULT PARAMETERS
# -----------------------------------------------------------------------------
# NSSF Act 2013 (Employee contribution rate: 6% Tier I & Tier II)
DEFAULT_NSSF_RATE=0.06

# SHIF 2024 (Social Health Insurance Fund: 2.75% of gross earnings)
DEFAULT_SHIF_RATE=0.0275

# SHIF Statutory Minimum Floor (KES 300.00 floor)
DEFAULT_SHIF_FLOOR=300.0

# Affordable Housing Levy Act 2024 (1.5% employee contribution)
DEFAULT_HOUSING_LEVY_RATE=0.015

# KRA PAYE Monthly Personal Tax Relief (KES 2,400.00)
DEFAULT_PERSONAL_RELIEF=2400.0

# Overtime Multipliers
OVERTIME_MULTIPLIER_NORMAL=1.5
OVERTIME_MULTIPLIER_HOLIDAY=2.0

# -----------------------------------------------------------------------------
# 6. COMPANY STATUTORY IDENTIFIERS
# -----------------------------------------------------------------------------
COMPANY_NAME="CorpSec Investigations & Guarding Services Ltd"
COMPANY_KRA_PIN="P051234567Z"
COMPANY_NSSF_CODE="NSSF-09876"
COMPANY_SHIF_CODE="SHIF-54321"

# -----------------------------------------------------------------------------
# 7. DOCUMENT STORAGE
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads/documents"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# -----------------------------------------------------------------------------
# 8. EXTERNAL INTEGRATIONS (SMTP Email & SMS Alerts)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CorpSec HR <no-reply@corpsec.co.ke>"

SMS_API_KEY=""
SMS_PARTNER_ID=""
SMS_SENDER_ID="CORPSEC"

# -----------------------------------------------------------------------------
# 9. SAFARICOM M-PESA DARAJA B2C INTEGRATION (Disbursement Automation)
# -----------------------------------------------------------------------------
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
